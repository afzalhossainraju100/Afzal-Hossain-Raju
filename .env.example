# Optional: your custom domain, used for Open Graph / social-share links.
# On Vercel you can leave this out; the project's production domain is used automatically.
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# Optional: deliver contact-form messages straight to your inbox (free key at https://web3forms.com)
# Without it, the form opens the visitor's email app (or Gmail / Outlook) with the message pre-filled.
NEXT_PUBLIC_WEB3FORMS_KEY=
